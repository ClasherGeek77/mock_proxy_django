[MESSAGES CONTROL]
# no docstrings in this project, f-string logs read better with values
# attribute-defined-outside-init: the request handler rebinds rfile/wfile/connection
# when it swaps in a tls socket.
# unused-argument: a django view takes the request whether it reads it or not.
# too-many-instance-attributes: the handler inherits the socketserver/http ones.
# redefined-outer-name: pytest fixtures are injected by parameter name.
# too-many-*, too-few-public-methods: a route table and request wrappers are
# flat on purpose, splitting them only scatters the logic
disable=missing-module-docstring,missing-function-docstring,missing-class-docstring,logging-fstring-interpolation,attribute-defined-outside-init,redefined-outer-name,too-few-public-methods,unused-argument,too-many-instance-attributes,too-many-return-statements,too-many-arguments

[FORMAT]
max-line-length=88
